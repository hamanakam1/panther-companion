{
  "name": "panther-companion",
  "version": "1.2.2",
  "private": true,
  "type": "module",
  "description": "Local-first companion that explains current evidence for the current goal, and stays quiet otherwise.",
  "main": "dist/src/electron/main.js",
  "bin": {
    "panther": "dist/src/cli.js"
  },
  "scripts": {
    "build": "node scripts/sync-version.mjs && tsc -p tsconfig.json && mkdir -p dist/surface && cp surface/card.html dist/surface/card.html && cp src/electron/preload.cjs dist/src/electron/preload.cjs",
    "test": "npm run build && node --test dist/test/*.test.js",
    "eval": "npm run build && node dist/eval/run.js",
    "serve": "node dist/src/cli.js serve",
    "electron": "electron .",
    "start": "npm run build && electron .",
    "explain": "npm run build && node dist/src/cli.js explain",
    "panther": "node dist/src/cli.js",
    "icon": "python3 scripts/make-icon.py",
    "package": "npm run build && electron-builder --mac dir",
    "package:dmg": "npm run build && electron-builder --mac dmg"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "electron": "^35.7.5",
    "electron-builder": "^26.18.0",
    "typescript": "^5.9.3"
  },
  "allowScripts": {
    "electron@35.7.5": true
  },
  "author": {
    "name": "Mike Hamanaka",
    "email": "mike@sjultra.com"
  }
}
